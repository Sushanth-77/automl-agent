# ── Google Gemini API (REQUIRED) ──────────────────────────────────────────────
# Get a free key from https://aistudio.google.com → "Get API key"
# No credit card required. Free tier: ~1,500 requests/day.
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Optional: Kaggle API (only needed for programmatic dataset download) ──────
# Download kaggle.json from https://www.kaggle.com/settings → API → Create New Token
# Place it at ~/.kaggle/kaggle.json  OR set these env vars:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Pipeline defaults (can be overridden via CLI flags or Streamlit UI) ────────
MAX_ITERATIONS=3
MOCK_MODE=false
LLM_MODEL=gemini-2.5-flash
